# dsh-raganything-kb sidecar environment (installed to <rag-home>/sidecar.env, mode 600)
# install.sh generates this file automatically; kept here for reference/recovery.

# LLM / vision API key. install.sh fills it from ~/.dsh/.credentials.yaml
# (refs.TOKENSTORE_API_KEY) when available. Set it by hand only if that fails.
RAG_LLM_API_KEY=

# Absolute path of the sidecar JSON config.
RAG_SIDECAR_CONFIG=__RAG_HOME__/config.json

# Bind address of the FastAPI sidecar.
RAG_SIDECAR_HOST=0.0.0.0
RAG_SIDECAR_PORT=17321

# Optional Bearer token required from remote callers (empty = no auth).
RAG_SIDECAR_TOKEN=

PYTHONUNBUFFERED=1
